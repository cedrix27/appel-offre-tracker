{
  "name": "src-digital-tender-watch",
  "private": true,
  "packageManager": "pnpm@8.15.8",
  "engines": {
    "node": ">=22.11",
    "pnpm": ">=8.15"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "setup:check": "bash scripts/setup.sh --check",
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm build:api && pnpm build:web",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "start": "node scripts/dev.mjs --prod",
    "lint": "pnpm lint:api && pnpm lint:web && pnpm lint:collector",
    "lint:api": "pnpm --filter api lint",
    "lint:web": "pnpm --filter web lint && pnpm --filter web typecheck",
    "lint:collector": "cd services/collector && .venv/bin/ruff check .",
    "test": "pnpm test:api && pnpm test:web && pnpm test:collector",
    "test:api": "pnpm --filter api test",
    "test:web": "pnpm --filter web test",
    "test:collector": "cd services/collector && .venv/bin/pytest",
    "test:e2e:api": "pnpm --filter api test:e2e",
    "test:e2e": "pnpm --filter web exec playwright test --config ../../e2e/playwright.config.ts",
    "test:all": "pnpm lint && pnpm test && pnpm test:e2e:api && pnpm test:e2e",
    "db:migrate": "pnpm --filter api exec prisma migrate deploy",
    "db:seed": "pnpm --filter api db:seed",
    "db:reset": "bash scripts/db-reset.sh",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "collector": "services/collector/.venv/bin/python -m collector"
  }
}
