# Valeurs fictives uniquement — copier en .env (jamais commité). `pnpm setup` le fait pour vous.
NODE_ENV=development

# --- Web (Next.js, port 3000) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# URL publique du web, utilisée dans les liens des e-mails (vérification, invitation, digest)
WEB_APP_URL=http://localhost:3000
# Adresse de l'API vue par le serveur Next (rewrites /api/*)
API_BASE_URL=http://localhost:4000

# --- API (NestJS, port 4000) ---
API_PORT=4000
# ≥ 16 caractères ; générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_me_with_a_long_random_secret
# true en production (HTTPS). Vide = automatique (true si NODE_ENV=production)
COOKIE_SECURE=
REFRESH_COOKIE_PATH=/api/auth
GLOBAL_RATE_LIMIT=300
AUTH_RATE_LIMIT=10
AUTH_RATE_TTL_MS=60000

# --- Base de données (PostgreSQL 17 Homebrew) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tender_watch?schema=public
# Base dédiée aux tests e2e (son nom doit contenir « test ») ; vidée à chaque suite
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tender_watch_test?schema=public

# --- Super administrateur créé par le seed (mot de passe ≥ 12 caractères) ---
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=

# --- E-mails : log (console + email_outbox) | smtp | brevo ---
EMAIL_PROVIDER=log
EMAIL_API_KEY=
EMAIL_FROM_NAME=SRC Digital
EMAIL_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# --- Pipeline quotidien ---
TENDER_SCAN_CRON=0 7 * * *
TENDER_TIMEZONE=Africa/Ouagadougou
# Active le cron 07:00 dans le processus API
PIPELINE_CRON_ENABLED=false
COLLECTOR_PYTHON=services/collector/.venv/bin/python
# Commande personnalisée (remplace `python -m collector run-job <id>`), utile en test
COLLECTOR_COMMAND=
COLLECTOR_TIMEOUT_MS=900000

# --- Collecteur Python ---
# mock (règles seules, aucun appel externe) | openai
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=90
# User-Agent identifié avec un contact (règle n°8)
COLLECTOR_USER_AGENT=SRC-Digital-Collector/0.1 (+contact@example.com)
# Délai entre requêtes, plancher imposé : 5 s
COLLECTOR_MIN_DELAY_SECONDS=5
COLLECTOR_HTTP_TIMEOUT_SECONDS=60
COLLECTOR_STORAGE_DIR=services/collector/data
# Dossier de fixtures pour un fonctionnement hors ligne (tests) ; vide = vraie source
COLLECTOR_OFFLINE_FIXTURES=
# Chemin de pdftotext si hors du PATH
PDFTOTEXT_BIN=
